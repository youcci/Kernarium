<resources>
    <!-- A phone's screen cuts its corners at a radius of 44 to 62 dp. The
         status bar's text stands clear of the largest of them from 14 dp in;
         this leaves it the room the host's own status bar keeps. -->
    <dimen name="rounded_corner_content_padding">30dp</dimen>

    <!-- The status bar itself takes its height from the cutout, but SystemUI
         sizes the rows of the opened shade's header, the lock screen's status
         bar and the like by this value, as a device with a cutout sets it. A
         phone's cutout reaches 47 to 62 dp down; one value near the tallest
         keeps those rows beside it. Landscape has no cutout at the top. -->
    <dimen name="status_bar_height_portrait">60dp</dimen>
    <dimen name="status_bar_height_landscape">24dp</dimen>
</resources>
