package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// The display cutout of a guest whose display fills the screen of a phone with
// a notch, and the status bar height that goes with it. Both are framework
// resources that the platform does not declare overlayable, so this overlay
// builds against SDK 28 as the pin overlay does. It is not static: the display
// shape script enables the one that fits the host's screen.
runtime_resource_overlay {
    name: "KernariumNotchOverlay",
    resource_dirs: ["res"],
    vendor: true,
    sdk_version: "28",
}
