<resources>
    <!-- A notch, the cutout of an iPhone whose top inset is below 59 dp: a
         rectangle in the middle of the top edge, where the path's origin is.
         It is the largest of its class, so it hides nothing on any such
         phone. The platform takes the status bar's height from it. -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false">M -115,0 L -115,50 L 115,50 L 115,0 Z @dp</string>

    <!-- SystemUI sizes the rows of the opened shade's header, the lock
         screen's status bar and the like by this value and not by the cutout,
         as a device with a cutout sets it. Landscape has no cutout at the top
         and keeps the platform's height. -->
    <dimen name="status_bar_height_portrait">50dp</dimen>
    <dimen name="status_bar_height_landscape">28dp</dimen>
</resources>
