// SPDX-License-Identifier: Apache-2.0
// The provider is goldfish's, which lives in a namespace of its own.
soong_namespace {
    imports: ["device/generic/goldfish"],
}
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}
cc_binary {
    name: "android.hardware.camera.provider-service.andarium",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.camera.provider-service.andarium.rc"],
    vintf_fragments: ["android.hardware.camera.provider-service.andarium.xml"],
    cpp_std: "c++20",
    srcs: ["HostCamera.cpp"],
    defaults: ["libcamera_provider_core.ranchu_deps"],
    header_libs: ["andarium_host_link_headers"],
    static_libs: ["libcamera_provider_core.ranchu"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
