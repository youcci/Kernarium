// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}
cc_binary {
    name: "android.hardware.vibrator-service.andarium",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.andarium.rc"],
    vintf_fragments: ["android.hardware.vibrator-service.andarium.xml"],
    cpp_std: "c++20",
    srcs: ["Vibrator.cpp"],
    header_libs: ["andarium_host_link_headers"],
    shared_libs: [
        "android.hardware.vibrator-V4-ndk",
        "libbase", "libbinder_ndk", "liblog",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
